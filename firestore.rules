rules_version = '2';

// Firestore Security Rules cho project `attendance-management-sy-34105`.
//
// Phạm vi: chỉ enforce AUTHORIZATION (ai được đọc/ghi document nào), khớp với
// cách attendance_mobile / attendance_admin đang thực sự đọc/ghi từng collection
// (đối chiếu trực tiếp với code repository hiện tại, xem docs/reviews/ và
// ROADMAP.md mục P1-05).
//
// Giới hạn đã biết (cố ý, đã ghi trong ROADMAP.md phần "Ngoài phạm vi"):
// rules này KHÔNG xác minh tính trung thực của giá trị GPS
// (latitude/longitude/distance/isLate...) do client tự tính rồi gửi lên —
// việc đó cần Cloud Functions và nằm ngoài phạm vi P1-05.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Đọc hồ sơ chính chủ request để xác định role/isActive.
    // Dùng get() vì dự án không dùng Firebase Auth Custom Claims.
    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return currentUserExists()
        && currentUserData().role == 'admin'
        && currentUserData().isActive == true;
    }

    // FEAT-05: đọc device_activations/{uid} CHỈ dùng nội bộ trong Rules (để
    // đối chiếu khi ghi users.trustedDeviceId) — KHÔNG BAO GIỜ cấp `allow
    // read` cho owner trên collection này (xem match /device_activations/
    // bên dưới). Xem docs/design/ANTI_FRAUD_DESIGN.md §4.6/§8.2.
    //
    // Luôn kiểm tra exists() trước khi get().data — đúng pattern đã có sẵn ở
    // isAdmin() (get().data trên document CHƯA từng tồn tại, vd nhân viên
    // chưa từng được cấp mã kích hoạt, làm rule lỗi thay vì trả false gọn
    // gàng nếu không guard trước).
    function deviceActivationExists(uid) {
      return exists(/databases/$(database)/documents/device_activations/$(uid));
    }

    function deviceActivationData(uid) {
      return get(/databases/$(database)/documents/device_activations/$(uid)).data;
    }

    // users/{uid} — hồ sơ nhân viên/admin, doc ID = Firebase Auth uid.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Tạo/xoá hồ sơ: chỉ admin (khớp EmployeeRepository.addEmployee/deleteEmployee).
      allow create, delete: if isAdmin();

      // Cập nhật: admin sửa toàn quyền.
      allow update: if isAdmin()
        // Chủ tài khoản chỉ tự sửa được field 'phone' (khớp
        // AuthRepository.updatePhoneNumber - mobile). Không ai tự đổi được
        // role/isActive/employeeCode/shiftGroup/departmentId của chính mình.
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']))
        // FEAT-05: chủ tài khoản tự ghi trustedDeviceId/deviceStatus CHỈ khi
        // device_activations/{uid} đã 'redeemed' (đúng mã, xem match bên
        // dưới) VÀ giá trị đang ghi khớp đúng newDeviceId đã lưu ở đó — client
        // không tự ý ghi đè trustedDeviceId bằng giá trị tuỳ ý.
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trustedDeviceId', 'deviceStatus'])
            && request.resource.data.deviceStatus == 'trusted'
            && deviceActivationExists(uid)
            && deviceActivationData(uid).status == 'redeemed'
            && request.resource.data.trustedDeviceId == deviceActivationData(uid).newDeviceId);
    }

    // FEAT-05: device_activations/{uid} — 1 document hiện hành/nhân viên
    // (docId = uid). Xem docs/design/ANTI_FRAUD_DESIGN.md §4.
    //
    // Nhân viên KHÔNG BAO GIỜ được `allow read` trên collection này —
    // Firestore không hỗ trợ bảo mật theo từng field trong 1 lượt đọc, nên
    // cấp đọc dù chỉ 1 field vô hại cũng vô tình lộ field `code`. Toàn bộ
    // việc đối chiếu mã diễn ra NGAY TRONG rule `allow update` bên dưới —
    // client "ghi mù" (gửi `lastAttemptCode`), Rules tự so khớp với `code`
    // đang lưu (Rules có quyền đọc resource.data dù client không có `read`).
    match /device_activations/{uid} {
      allow read: if isAdmin();

      // Admin cấp mã lần đầu / cấp lại (set() ghi đè toàn bộ document).
      allow create: if isAdmin();

      allow update: if isAdmin()
        // Write A — LUÔN được phép ghi (kể cả đoán sai): tăng đúng 1
        // attemptCount + ghi lại mã vừa nhập, miễn còn "ngân sách" thử và
        // chưa hết hạn/chưa redeemed. Không được đổi field nào khác.
        || (isOwner(uid)
            && resource.data.status == 'pending'
            && resource.data.attemptCount < 5
            && resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptCount', 'lastAttemptCode'])
            && request.resource.data.attemptCount == resource.data.attemptCount + 1)
        // Write B — chỉ được phép chuyển sang 'redeemed' nếu lastAttemptCode
        // (vừa ghi ở Write A) khớp đúng code thật đang lưu. Đây là bước đối
        // chiếu mã DUY NHẤT của toàn bộ cơ chế, hoàn toàn phía server.
        || (isOwner(uid)
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && resource.data.lastAttemptCode == resource.data.code
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'newDeviceId'])
            && request.resource.data.status == 'redeemed');

      allow delete: if false;
    }

    // FEAT-05: device_audit_log/{id} — append-only, đóng vai trò Activation
    // History (không tạo collection riêng, xem
    // docs/design/ANTI_FRAUD_DESIGN.md §6).
    match /device_audit_log/{id} {
      // Đọc: Admin đọc toàn bộ; nhân viên chỉ đọc log của chính mình (minh
      // bạch, xem thiết kế §5.3/§7).
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);

      // Tạo: Admin (cấp mã/reset) hoặc chính nhân viên ghi log hành động họ
      // vừa thực hiện (redeem thành công).
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.actorUid == request.auth.uid);

      allow update, delete: if false;
    }

    // attendance/{docId} — docId dạng "<yyyy-MM-dd>_<uid>", 1 doc/người/ngày.
    match /attendance/{docId} {
      // get: đọc 1 document cụ thể (vd getTodayAttendance) — xét theo docId (đã
      // gồm uid theo quy ước "<yyyy-MM-dd>_<uid>") thay vì resource.data.uid, để
      // không phụ thuộc dữ liệu document (tránh permission-denied khi document
      // chưa tồn tại, lúc đó resource == null và resource.data.uid gây lỗi).
      allow get: if isSignedIn() && (
        isAdmin() ||
        docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
      );

      // list: đọc nhiều document qua query (vd lịch sử chấm công, dashboard admin).
      // isAdmin() gọi get() trên đúng 1 document đã biết trước (users/{request.auth.uid}),
      // không phụ thuộc dữ liệu các document mà query trả về, nên Firestore tính được
      // ngay mà không cần "chứng minh qua cấu trúc query" — an toàn cho list.
      // Nhánh còn lại (resource.data.uid == request.auth.uid) được chứng minh nhờ
      // client luôn lọc .where('uid', isEqualTo: uid) trong các query của nhân viên.
      allow list: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid
      );

      // Check-in: chỉ tạo được đúng doc của chính mình, đúng quy ước đặt tên
      // "<yyyy-MM-dd>_<uid>" (khớp AttendanceRepository.checkIn - mobile).
      // FEAT-05: bắt buộc deviceId khớp trustedDeviceId đã lưu ở users/{uid}
      // — đây là điểm enforce Device Binding THẬT sự (khác GPS, deviceId có
      // nguồn đối chiếu độc lập phía server — xem
      // docs/design/ANTI_FRAUD_DESIGN.md §6.2/§8.3).
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
        && currentUserExists()
        && request.resource.data.deviceId == currentUserData().trustedDeviceId;

      // Check-out: chỉ chủ bản ghi được cập nhật, không đổi được uid sang
      // người khác. FEAT-05: cùng điều kiện deviceId như create — v1 của
      // thiết kế từng bỏ sót nhánh update này (đã ghi nhận là lỗ hổng, vá
      // ở đây), xem docs/design/ANTI_FRAUD_DESIGN.md §6.1.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && currentUserExists()
        && request.resource.data.deviceId == currentUserData().trustedDeviceId;

      allow delete: if false;
    }

    // company_settings/main — cấu hình công ty dùng chung.
    match /company_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // departments/{id}
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // leave_requests/{id}
    match /leave_requests/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Nhân viên tự tạo đơn nghỉ phép của chính mình.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // Duyệt/từ chối: chỉ admin (khớp LeaveRepository.updateLeaveStatus - admin).
      allow update: if isAdmin();

      allow delete: if false;
    }

    // notifications/{id} — chỉ admin gửi (khớp NotificationRepository.sendNotification).
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Mặc định chặn mọi collection khác không được khai báo tường minh ở trên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
